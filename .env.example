JWT_SECRET=change-me

MAIL_USERNAME=
MAIL_PASSWORD=

PYTHON_AGENT_BASE_URL=http://localhost:8000
INTERNAL_AGENT_SERVICE_TOKEN=change-me
DB_FILE=./data/ai_resume.db

# Agent 任务队列（SQLite 任务表，取代原来的 RabbitMQ / Redis Stream）
# Java 和 Python 两端必须配成同一组 stream 名，否则消息投递不到消费者。
AGENT_RESUME_RUN_STREAM=agent.resume.run
AGENT_INTERVIEW_RUN_STREAM=agent.interview.run
AGENT_RUN_RESULT_STREAM=agent.run.result
AGENT_RUN_DLQ_STREAM=agent.run.dlq

# 本地磁盘存储根目录，留空默认用「用户主目录/Documents/AI-Resume-Forge」
STORAGE_ROOT=

# MiniMax（Anthropic 兼容接口）
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_MAX_TOKENS=4096
MINIMAX_ANTHROPIC_API_KEY=