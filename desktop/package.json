{
  "name": "ai-resume-forge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI Resume Forge 桌面端：Electron 主进程 + 复用 desktop/renderer/ 渲染层",
  "author": "Elias",
  "license": "UNLICENSED",
  "main": "dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "node scripts/build-electron.mjs",
    "build:renderer": "vite build --config vite.config.mts",
    "build:stage": "node scripts/stage-renderer.mjs",
    "build": "npm run build:renderer && npm run build:main && npm run build:stage",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.config.mts",
    "dev:electron": "npm run build:main && cross-env AI_RESUME_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "package": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue": "^3.5.32"
  },
  "build": {
    "appId": "com.elias.resumeforge.desktop",
    "productName": "AI Resume Forge",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
