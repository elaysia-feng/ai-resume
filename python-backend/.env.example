# ============ LangSmith 可观测平台 ============
# 注册地址：https://smith.langchain.com/
# 启用后所有 LangChain/LangGraph 调用自动 tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-resume-forge  # 项目名，可自定义

# ============ LLM（provider 二选一）============
# LLM_PROVIDER: mimo / deepseek。切换后 agent_factory 自动读取对应的生效配置。
LLM_PROVIDER=mimo
LLM_TIMEOUT_SECONDS=60

# --- MiMo（LLM_PROVIDER=mimo 时生效）---
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5-pro

# --- DeepSeek（LLM_PROVIDER=deepseek 时生效）---
# deepseek-chat 快速非推理；deepseek-v4-flash 推理模型（更慢更贵）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ============ Qdrant Cloud ============
QDRANT_URL=https://api.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=resume_chunks

# ============ Embedding（本地 SentenceTransformer）============
# 模型缓存路径，首次运行后会自动缓存，无需手动下载
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_FOLDER=F:\AI\embedding_models
EMBEDDING_DIMENSION=512

# ============ Java Internal API ============
JAVA_INTERNAL_BASE_URL=http://localhost:8080
INTERNAL_AGENT_SERVICE_TOKEN=

# ============ Agent Runtime ============
REDIS_URL=redis://localhost:6379/0
AGENT_REVIEW_MAX_RETRY=2
AGENT_CHECKPOINT_TTL_SECONDS=3600

# ============ 评测系统（RAG A/B + 质量评分）============
# RAG 检索模式：auto（默认，LLM 决定是否检索）/ on（强制检索）/ off（关闭检索，评测 A/B 用）
AGENT_RETRIEVAL_MODE=auto
# 评测系统是否用 LLM 给优化结果做 rubric 打分；false 时只跑确定性规则（免费）
AGENT_QUALITY_LLM_SCORING=true
